{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended", "group:allNonMajor"],
	"ignorePaths": [".github/workflows/release.yml"],
	"automerge": true,
	"automergeType": "branch",
	"platformAutomerge": false,
	"lockFileMaintenance": {
		"enabled": true,
		"automerge": true
	},
	"customManagers": [
		{
			"customType": "regex",
			"fileMatch": ["^dist-workspace\\.toml$"],
			"matchStrings": ["cargo-dist-version\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
			"depNameTemplate": "cargo-dist",
			"datasourceTemplate": "crate"
		}
	],
	"packageRules": [
		{
			"description": "Keep cargo-dist updates manual because release.yml is generated from it",
			"matchManagers": ["custom.regex"],
			"matchPackageNames": ["cargo-dist"],
			"automerge": false
		},
		{
			"description": "Automerge non-major updates",
			"matchUpdateTypes": ["minor", "patch"],
			"automerge": true
		},
		{
			"description": "Major updates need manual review",
			"matchUpdateTypes": ["major"],
			"automerge": false
		}
	]
}
