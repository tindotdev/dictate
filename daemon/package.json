{
	"name": "@tindotdev/dictate",
	"version": "0.2.0",
	"description": "Speech-to-text daemon for Neovim using OpenAI Realtime API",
	"type": "module",
	"main": "dist/main.js",
	"bin": {
		"dictated": "dist/main.js",
		"dictatectl": "dist/cli/dictatectl.js",
		"dictate": "dist/cli/dictate.js"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "tsx watch src/main.ts",
		"build": "tsup",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"coverage": "bun test --coverage",
		"check": "bunx biome check --write --unsafe"
	},
	"keywords": [
		"neovim",
		"speech-to-text",
		"dictation",
		"openai",
		"realtime-api"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tindotdev/dictate.git",
		"directory": "daemon"
	},
	"dependencies": {
		"zod": "^4.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@types/bun": "^1.3.5",
		"@types/node": "^25.0.3",
		"@types/ws": "^8.18.1",
		"tsup": "^8.5.1",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"ws": "^8.18.3"
	}
}
