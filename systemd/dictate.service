[Unit]
Description=Dictate Daemon
After=pipewire.service

[Service]
Type=simple
# __BUN_PATH__ is replaced by install-service.sh with the actual bun directory
Environment=PATH=__BUN_PATH__:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# __EXEC_START__ is replaced by install-service.sh with the actual daemon command
ExecStart=__EXEC_START__
Restart=on-failure
RestartSec=5
EnvironmentFile=-%h/.config/dictate/env

# Note: Bun doesn't support systemd socket activation (fd passing).
# The daemon creates its own socket at $XDG_RUNTIME_DIR/dictate/dictate.sock

[Install]
WantedBy=default.target
