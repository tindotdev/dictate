[Unit]
Description=Say Dictation Daemon
After=pipewire.service

[Service]
Type=simple
Environment=PATH=%h/.local/bin:%h/.bun/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env bun run %h/.local/share/nvim/lazy/say/daemon/dist/main.js
Restart=on-failure
RestartSec=5
EnvironmentFile=-%h/.config/say/env

# Note: Bun doesn't support systemd socket activation (fd passing).
# The daemon creates its own socket at $XDG_RUNTIME_DIR/say/say.sock

[Install]
WantedBy=default.target
