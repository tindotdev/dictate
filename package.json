{
  "name": "dictate",
  "private": true,
  "workspaces": ["daemon"],
  "scripts": {
    "build": "cd daemon && bun run build",
    "check": "bun run check:daemon && bun run check:nvim",
    "check:daemon": "cd daemon && bun run check",
    "check:nvim": "cd nvim && stylua --check . && selene lua",
    "fix": "bun run fix:daemon && bun run fix:nvim",
    "fix:daemon": "cd daemon && bun run check",
    "fix:nvim": "cd nvim && stylua .",
    "prepare": "lefthook install",
    "publish:daemon": "cd daemon && bun run build && npm publish"
  },
  "devDependencies": {
    "lefthook": "^1.6.0"
  }
}
